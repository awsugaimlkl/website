---
import BaseLayout from "../../layouts/BaseLayout.astro";
import EventCard from "../../components/EventCard.astro";
import { getEvents } from "../../lib/events.js";
import { SITE } from "../../lib/site.js";

const { upcoming, past } = getEvents();
---

<BaseLayout
  title={`Events | ${SITE.shortName}`}
  description="Upcoming events and past meetups from AWS User Group AI/ML Kuala Lumpur, with the talks given at each one."
>
  <main id="main" class="section">
    <div class="container">
      <span class="eyebrow">Community Events</span>
      <h1>Learn, build and connect.</h1>
      <p class="intro">
        Meetups, workshops and community-led events for AI/ML practitioners and enthusiasts in Kuala Lumpur.
      </p>

      <section class="group" aria-labelledby="upcoming-heading">
        <h2 id="upcoming-heading">Upcoming</h2>
        {upcoming.length > 0 ? (
          <div class="grid-3">
            {upcoming.map((event) => <EventCard {...event} />)}
          </div>
        ) : (
          <p class="empty">
            Nothing is scheduled right now. New meetups are announced on{" "}
            <a class="text-link" href={SITE.meetup} target="_blank" rel="noopener noreferrer">Meetup</a>{" "}first.
          </p>
        )}
      </section>

      {past.length > 0 && (
        <section class="group" aria-labelledby="past-heading">
          <h2 id="past-heading">Past meetups</h2>
          <div class="grid-3">
            {past.map((event) => <EventCard {...event} />)}
          </div>
        </section>
      )}
    </div>
  </main>
</BaseLayout>

<style>
h1 { max-width: 850px; margin: 12px 0; }
.intro { max-width: 700px; font-size: 1.15rem; }
.group { margin-top: 56px; }
.group h2 { font-size: clamp(1.6rem, 3vw, 2.2rem); margin-bottom: 22px; }
.empty { max-width: 640px; }
</style>
