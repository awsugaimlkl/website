---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import EventCard from "../components/EventCard.astro";
import logo from "../assets/logo.png";
import { getEvents } from "../lib/events.js";
import { getPhoto } from "../lib/photos.js";
import TeamMember from "../components/TeamMember.astro";
import { SITE } from "../lib/site.js";
import { TEAM } from "../lib/team.js";

const { upcoming, past } = getEvents();

// The event shown in the highlight band: the next featured one, or simply the next one.
const next = upcoming.find((e) => e.featured) ?? upcoming[0];
// Any other upcoming events get their own section, so nothing is listed twice.
const otherUpcoming = upcoming.filter((e) => e !== next);
const recent = past.slice(0, 3);

const nextDate = next ? new Date(`${next.date}T12:00:00+08:00`) : null;
const day = nextDate?.toLocaleDateString("en-GB", { day: "numeric", timeZone: "Asia/Kuala_Lumpur" });
const month = nextDate?.toLocaleDateString("en-GB", { month: "short", timeZone: "Asia/Kuala_Lumpur" });
const year = nextDate?.toLocaleDateString("en-GB", { year: "numeric", timeZone: "Asia/Kuala_Lumpur" });

const organizationData = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: SITE.name,
  url: Astro.site,
  logo: new URL("/favicon-192.png", Astro.site),
  description: SITE.description,
  foundingDate: "2025-11",
  areaServed: "Kuala Lumpur, Malaysia",
  sameAs: [SITE.meetup, SITE.linkedin],
};
---

<BaseLayout>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(organizationData)} />

  <main id="main">

    <section class="hero">
      <div class="container hero-grid">
        <div>
          <span class="eyebrow">AWS User Group · Kuala Lumpur</span>
          <h1>
            Where <span class="gradient-text">AI/ML builders</span> connect.
          </h1>

          <p class="hero-copy">
            A community for practitioners, developers, engineers, students and enthusiasts exploring artificial intelligence and machine learning on AWS.
          </p>

          <div class="actions hero-actions">
            <a class="btn btn-primary" href="/events/">Explore events</a>
            <a class="btn btn-secondary" href={SITE.meetup} target="_blank" rel="noopener noreferrer">Join on Meetup</a>
          </div>

          <div class="topics">
            <span class="tag">Generative AI</span>{" "}
            <span class="tag">Amazon Bedrock</span>{" "}
            <span class="tag">Machine Learning</span>{" "}
            <span class="tag">Agentic AI</span>{" "}
            <span class="tag">MLOps</span>
          </div>
        </div>

        <div class="visual">
          <div class="logo-showcase">
            <Image
              class="hero-logo"
              src={logo}
              alt="AWS User Group AI/ML Kuala Lumpur logo"
              widths={[300, 420, 535]}
              sizes="(max-width: 850px) 300px, 420px"
              loading="eager"
            />
          </div>
          <div class="orb orange"></div>
          <div class="orb purple"></div>
          <div class="orb teal"></div>
        </div>
      </div>
    </section>

    {next && (
      <section class="community-day section" data-event-date={next.date} data-hide-when-past>
        <div class="container event-highlight">
          <div>
            <span class="eyebrow">Next event</span>
            <h2>{next.title}</h2>
            <p class="when">{next.dateDisplay}<br />{next.venue}</p>
            <p>{next.description}</p>
            <a class="btn btn-primary" href={next.href}>Event details</a>
          </div>

          <div class="date-block" aria-hidden="true">
            <strong>{day}</strong>{" "}
            <span>{month}</span>{" "}
            <small>{year}</small>
          </div>
        </div>
      </section>
    )}

    <section class="section" id="about">
      <div class="container">
        <span class="eyebrow">About the community</span>
        <h2>Built by the community,<br/>for the community.</h2>
        <p class="about-copy">
          We started in November 2025 and meet in person at company offices around Kuala Lumpur. Whether you are getting started with Amazon SageMaker, experimenting with generative AI on Amazon Bedrock, or running ML pipelines in production, you will find people here working on the same problems.
        </p>

        <div class="grid-3 about-grid">
          <article class="card accent-purple">
            <h3>Learn</h3>
            <p>Technical talks, workshops and demonstrations covering practical AI/ML technologies and AWS services.</p>
          </article>

          <article class="card accent-orange">
            <h3>Share</h3>
            <p>A platform for practitioners to share lessons, architectures, experiments and real-world experiences.</p>
          </article>

          <article class="card accent-teal">
            <h3>Connect</h3>
            <p>Meet engineers, data scientists, developers, architects, students and fellow technology enthusiasts.</p>
          </article>
        </div>

        <div class="proof">
          <figure class="photo">
            <Image
              src={getPhoto("meetup-room")}
              alt="A full room of attendees watching a talk, with the AWS User Groups AI/ML Kuala Lumpur banner beside the screen"
              widths={[480, 760, 1100, 1462]}
              sizes="(max-width: 850px) calc(100vw - 28px), 680px"
            />
          </figure>

          <dl class="facts">
            <div>
              <dt>2,000+</dt>
              <dd>members on Meetup</dd>
            </div>
            <div>
              <dt>6</dt>
              <dd>meetups since our first one in November 2025</dd>
            </div>
            <div>
              <dt>4.7 of 5</dt>
              <dd>average from 92 member ratings on Meetup</dd>
            </div>
          </dl>
        </div>
      </div>
    </section>

    {otherUpcoming.length > 0 && (
      <section class="section event-section">
        <div class="container">
          <div class="section-heading">
            <div>
              <span class="eyebrow">What's happening</span>
              <h2>Upcoming events</h2>
            </div>
            <a class="text-link" href="/events/">View all events</a>
          </div>

          <div class="grid-3">
            {otherUpcoming.slice(0, 3).map((event) => <EventCard {...event} />)}
          </div>
        </div>
      </section>
    )}

    {recent.length > 0 && (
      <section class="section event-section">
        <div class="container">
          <div class="section-heading">
            <div>
              <span class="eyebrow">What we have covered</span>
              <h2>Recent meetups</h2>
            </div>
            <a class="text-link" href="/events/">View all events</a>
          </div>

          <div class="grid-3">
            {recent.map((event) => <EventCard {...event} />)}
          </div>
        </div>
      </section>
    )}

    <section class="section" id="community">
      <div class="container">
        <span class="eyebrow">Get involved</span>
        <h2>Join the AWS AI/ML community.</h2>

        <div class="social-grid">
          <a class="social card meetup-card" href={SITE.meetup} target="_blank" rel="noopener noreferrer">
            <span>Meetup</span>{" "}
            <strong>Attend our next event</strong>
          </a>

          <a class="social card linkedin-card" href={SITE.linkedin} target="_blank" rel="noopener noreferrer">
            <span>LinkedIn</span>{" "}
            <strong>Follow community updates</strong>
          </a>

          <a class="social card facebook-card" href={SITE.facebook} target="_blank" rel="noopener noreferrer">
            <span>Facebook</span>{" "}
            <strong>Join the discussion</strong>
          </a>
        </div>

        <div class="ways">
          <div>
            <h3>Give a talk</h3>
            <p>Built something with Bedrock, SageMaker or agents on AWS? Show it. We run full talks and short lightning talks.</p>
            <a class="text-link" href={SITE.linkedin} target="_blank" rel="noopener noreferrer">Propose a talk on LinkedIn</a>
          </div>
          <div>
            <h3>Host a meetup</h3>
            <p>We meet at offices around Kuala Lumpur. Past hosts are AWS Malaysia, The Access Group, Arvato Systems and Xendit.</p>
            <a class="text-link" href={SITE.linkedin} target="_blank" rel="noopener noreferrer">Offer a venue on LinkedIn</a>
          </div>
          <div>
            <h3>Volunteer or sponsor</h3>
            <p>Help run a meetup or Community Day on the day, or support the group as a sponsor.</p>
            <a class="text-link" href={SITE.linkedin} target="_blank" rel="noopener noreferrer">Message us on LinkedIn</a>
          </div>
        </div>

      </div>
    </section>

    <section class="section team-section" id="team">
      <div class="container">
        <span class="eyebrow">Who runs the group</span>
        <h2>User group leaders</h2>
        <p class="team-copy">The group is led by its User Group Leaders, all volunteers. Say hello at the next meetup, or reach out on LinkedIn.</p>

        <div class="grid-3 team-grid">
          {TEAM.map((member) => <TeamMember {...member} />)}
        </div>
      </div>
    </section>

    <section class="section gallery-section" id="gallery">
      <div class="container">
        <span class="eyebrow">Community moments</span>
        <h2>Featured meetup photos</h2>

        <div class="gallery-grid">
          <a class="gallery" href="/events/2026-05-meetup/">
            <Image
              src={getPhoto("2026-05-meetup")}
              alt="A speaker presents on spec-driven development to a full room under hexagon-shaped ceiling lights"
              width={1100}
              widths={[480, 760, 1100]}
              sizes="(max-width: 850px) calc(100vw - 28px), 440px"
            />
            <span>May 2026 at Xendit Malaysia</span>
          </a>

          <a class="gallery" href="/events/2026-04-meetup/">
            <Image
              src={getPhoto("2026-04-meetup")}
              alt="A speaker with a microphone talks to rows of seated attendees in a meeting room"
              width={1100}
              widths={[480, 760, 1100]}
              sizes="(max-width: 850px) calc(100vw - 28px), 440px"
            />
            <span>April 2026 at Arvato Systems</span>
          </a>

          <div class="albums card">
            <h3>Photo albums</h3>
            <p>Full albums on Google Photos, for the meetups that have one.</p>
            <ul>
              <li><a class="text-link" href="https://photos.app.goo.gl/13eRnUZjgnFzkSt69" target="_blank" rel="noopener noreferrer">May 2026 meetup</a></li>
              <li><a class="text-link" href="https://photos.app.goo.gl/sdN9weecTJRPnyNw7" target="_blank" rel="noopener noreferrer">April 2026 meetup</a></li>
              <li><a class="text-link" href="https://photos.app.goo.gl/5CeVYFS48nEERN578" target="_blank" rel="noopener noreferrer">November 2025 meetup</a></li>
            </ul>
          </div>
        </div>
      </div>
    </section>

  </main>
</BaseLayout>

<style>
.hero {
  min-height: 720px;
  display: flex;
  align-items: center;
  padding: 100px 0;
}

.hero-grid {
  display: grid;
  grid-template-columns: 1.2fr .8fr;
  align-items: center;
  gap: 70px;
}

.hero h1 {
  max-width: 850px;
  margin: 16px 0 26px;
}

.hero-copy {
  max-width: 720px;
  font-size: 1.2rem;
}

.hero-actions {
  margin-top: 32px;
}

.topics {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin-top: 36px;
}

.visual {
  min-height: 420px;
  position: relative;
  display: grid;
  place-items: center;
}

.logo-showcase {
  position: relative;
  z-index: 2;
  width: min(420px, 90%);
  display: grid;
  place-items: center;
  filter: drop-shadow(0 20px 45px rgba(168,85,247,.18));
}

.hero-logo {
  width: 100%;
  height: auto;
  display: block;
}

.orb {
  position: absolute;
  border-radius: 999px;
  filter: blur(2px);
}

.orange {
  width: 90px;
  height: 90px;
  background: rgba(255,153,0,.3);
  top: 25px;
  right: 15px;
}

.purple {
  width: 145px;
  height: 145px;
  background: rgba(168,85,247,.2);
  bottom: 10px;
  left: -15px;
}

.teal {
  width: 54px;
  height: 54px;
  background: rgba(45,212,191,.28);
  bottom: 80px;
  right: 5px;
}

.community-day {
  padding-top: 20px;
}

.event-highlight {
  border: 1px solid var(--border);
  border-radius: 28px;
  padding: 55px;
  display: grid;
  grid-template-columns: 1fr auto;
  align-items: center;
  gap: 50px;
  background:
    radial-gradient(circle at 90% 10%,rgba(255,153,0,.17),transparent 30%),
    radial-gradient(circle at 15% 100%,rgba(168,85,247,.16),transparent 40%),
    #121217;
}

.event-highlight h2 {
  margin: 12px 0 16px;
}

.event-highlight p {
  max-width: 700px;
}

.event-highlight .when {
  margin: 0 0 14px;
  color: #fff;
  font-weight: 700;
  font-size: 1.15rem;
  line-height: 1.4;
}

.event-highlight .btn {
  margin-top: 8px;
}

.date-block {
  width: 220px;
  height: 220px;
  border: 1px solid rgba(255,153,0,.45);
  border-radius: 28px;
  display: grid;
  place-content: center;
  text-align: center;
  background: rgba(255,153,0,.06);
}

.date-block strong {
  color: var(--orange);
  font-size: 5.6rem;
  line-height: .8;
}

.date-block span {
  font-size: 1.7rem;
  letter-spacing: .25em;
  text-transform: uppercase;
  margin-top: 14px;
}

.date-block small { color: var(--muted); }

.about-copy {
  max-width: 760px;
  font-size: 1.12rem;
  margin: 0;
}

.about-grid { margin-top: 42px; }

.about-grid article {
  padding: 28px;
}

.about-grid h3 {
  margin: 6px 0 12px;
  font-size: 1.9rem;
}

.about-grid p {
  margin: 0;
}

.accent-purple { border-top: 3px solid var(--purple); }
.accent-orange { border-top: 3px solid var(--orange); }
.accent-teal { border-top: 3px solid var(--teal); }

.proof {
  display: grid;
  grid-template-columns: 1.45fr 1fr;
  gap: 50px;
  align-items: center;
  margin-top: 56px;
}

.facts {
  margin: 0;
}

.facts > div {
  padding: 20px 0;
  border-top: 1px solid var(--border);
}

.facts > div:last-child {
  border-bottom: 1px solid var(--border);
}

.facts dt {
  font-size: clamp(2rem, 3.4vw, 2.8rem);
  font-weight: 800;
  line-height: 1;
  letter-spacing: -.04em;
}

.facts dd {
  margin: 8px 0 0;
  color: var(--muted);
}

.event-section {
  padding-top: 20px;
}

.section-heading {
  display: flex;
  justify-content: space-between;
  align-items: end;
  gap: 20px;
  margin-bottom: 32px;
}

.section-heading h2 { margin-bottom: 0; }

.social-grid {
  display: grid;
  grid-template-columns: repeat(3,1fr);
  gap: 18px;
}

.social {
  padding: 28px;
  min-height: 150px;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  transition: transform .2s ease;
}

.social:hover { transform: translateY(-4px); }

.social span { color: var(--muted); }
.social strong { font-size: 1.15rem; }

.meetup-card { border-bottom: 3px solid var(--orange); }
.linkedin-card { border-bottom: 3px solid var(--purple); }
.facebook-card { border-bottom: 3px solid var(--teal); }

.ways {
  display: grid;
  grid-template-columns: repeat(3,1fr);
  gap: 34px 40px;
  margin-top: 56px;
}

.ways h3 {
  font-size: 1.4rem;
  margin-bottom: 10px;
}

.ways p {
  margin: 0 0 12px;
}

.team-section {
  padding-top: 20px;
}

.team-copy {
  max-width: 640px;
  font-size: 1.12rem;
  margin: 0;
}

.team-grid {
  margin-top: 36px;
}

.gallery-grid {
  display: grid;
  grid-template-columns: 1fr 1fr .8fr;
  gap: 18px;
  margin-top: 36px;
}

.gallery {
  position: relative;
  display: block;
  border-radius: 22px;
  border: 1px solid var(--border);
  overflow: hidden;
  transition: transform .2s ease;
}

.gallery:hover { transform: translateY(-4px); }

.gallery :global(img) {
  display: block;
  width: 100%;
  height: 100%;
  min-height: 280px;
  object-fit: cover;
}

.gallery span {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 44px 22px 18px;
  font-weight: 800;
  background: linear-gradient(to top, rgba(9,9,11,.92), rgba(9,9,11,0));
}

.albums {
  padding: 26px;
}

.albums h3 {
  font-size: 1.4rem;
  margin-bottom: 8px;
}

.albums p {
  margin: 0 0 14px;
}

.albums ul {
  list-style: none;
  padding: 0;
  margin: 0;
  display: grid;
  gap: 10px;
}

@media(max-width:850px) {
  .hero { min-height: auto; padding: 60px 0 40px; }
  .hero-grid { grid-template-columns: 1fr; gap: 40px; }
  .visual { min-height: 320px; }
  .logo-showcase { width: min(280px, 78%); }
  .event-highlight { grid-template-columns:1fr; padding:30px; }
  .date-block { width:100%; height:170px; }
  .proof,
  .social-grid,
  .ways,
  .gallery-grid { grid-template-columns:1fr; }
  .section-heading { align-items:start; flex-direction:column; gap:10px; }
}
</style>
