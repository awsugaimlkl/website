---
import { Image } from "astro:assets";
import logo from "../assets/logo.png";
import { isPast } from "../lib/dates.js";
import { SITE } from "../lib/site.js";

// The event with its own button in the menu. It is set in src/lib/site.js
// and drops out once its date has passed.
const highlight = SITE.highlight && !isPast(SITE.highlight.date) ? SITE.highlight : null;
const trim = (path) => path.replace(/\/$/, "");
const onHighlight = highlight && trim(Astro.url.pathname) === trim(highlight.href);

const links = [
  { href: "/#about", label: "About" },
  { href: "/events/", label: "Events" },
  { href: "/#community", label: "Community" },
  { href: "/#team", label: "Team" },
  { href: "/#gallery", label: "Gallery" },
];
---

<header class:list={["site-header", { "has-highlight": highlight }]}>
  <div class="container nav">
    <a href="/" class="brand">
      <Image class="brand-logo" src={logo} alt="" width={48} densities={[1, 2, 3]} loading="eager" />
      <span>
        {/* The space keeps the two lines apart for screen readers and for anything that reads the page as plain text. */}
        <strong>AWS UG AI/ML</strong>{" "}<small>Kuala Lumpur</small>
      </span>
    </a>

    <!-- Wide screens: links in a row. On tablets only the event button stays in the bar. -->
    <nav class="desktop-nav" aria-label="Main">
      {links.map((link) => <a href={link.href}>{link.label}</a>)}
      {highlight && (
        <a
          class="highlight"
          href={highlight.href}
          aria-current={onHighlight ? "page" : undefined}
          data-event-date={highlight.date}
          data-hide-when-past
        >
          <span class="hex" aria-hidden="true"></span>{highlight.label}
        </a>
      )}
      <a class="meetup" href={SITE.meetup} target="_blank" rel="noopener noreferrer">Join Meetup</a>
    </nav>

    <!-- Phones: the same links behind a Menu button. Works without JavaScript. -->
    <details class="mobile-nav">
      <summary>Menu</summary>
      <nav aria-label="Main">
        {highlight && (
          <a
            class="highlight"
            href={highlight.href}
            aria-current={onHighlight ? "page" : undefined}
            data-event-date={highlight.date}
            data-hide-when-past
          >
            <span class="hex" aria-hidden="true"></span>{highlight.label}
          </a>
        )}
        {links.map((link) => <a href={link.href}>{link.label}</a>)}
        <a class="meetup" href={SITE.meetup} target="_blank" rel="noopener noreferrer">Join Meetup</a>
      </nav>
    </details>
  </div>
</header>

<style>
.site-header {
  position: sticky;
  top: 0;
  z-index: 50;
  backdrop-filter: blur(18px);
  background: rgba(9,9,11,.78);
  border-bottom: 1px solid rgba(255,255,255,.07);
}

.nav {
  height: 72px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
}

.brand {
  display: flex;
  align-items: center;
  gap: 12px;
}

.brand strong,
.brand small {
  display: block;
}

.brand strong {
  font-size: .95rem;
  line-height: 1.1;
}

.brand small {
  color: #a1a1aa;
  font-size: .75rem;
  line-height: 1.1;
  margin-top: 3px;
}

.brand-logo {
  width: 46px;
  height: auto;
  display: block;
  flex-shrink: 0;
}

.desktop-nav {
  display: flex;
  gap: 26px;
  align-items: center;
  font-size: .92rem;
  margin-left: auto;
}

.desktop-nav a:not(.meetup, .highlight) {
  color: #d4d4d8;
}

.desktop-nav a:not(.meetup, .highlight):hover {
  color: #fff;
}

/* The event button: an outline in the logo's orange and purple, with a small hexagon like the badge */
.highlight {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 9px;
  padding: 8.5px 15px;
  border: 1.5px solid transparent;
  border-radius: 10px;
  color: #fff;
  font-weight: 800;
  white-space: nowrap;
  background:
    linear-gradient(#111118, #111118) padding-box,
    linear-gradient(100deg, var(--orange), var(--purple)) border-box;
}

.highlight:hover {
  background:
    linear-gradient(100deg, rgba(255,153,0,.2), rgba(168,85,247,.26)) padding-box,
    linear-gradient(#111118, #111118) padding-box,
    linear-gradient(100deg, var(--orange), var(--purple)) border-box;
}

.hex {
  width: 10px;
  height: 11px;
  flex-shrink: 0;
  background: var(--orange);
  clip-path: polygon(50% 0, 100% 25%, 100% 75%, 50% 100%, 0 75%, 0 25%);
}

.meetup {
  background: #ff9900;
  color: #111;
  padding: 10px 16px;
  border-radius: 10px;
  font-weight: 800;
}

.mobile-nav {
  display: none;
}

.mobile-nav summary {
  list-style: none;
  cursor: pointer;
  padding: 9px 16px;
  border: 1px solid #3f3f4a;
  border-radius: 10px;
  font-weight: 750;
  font-size: .92rem;
}

.mobile-nav summary::-webkit-details-marker {
  display: none;
}

.mobile-nav[open] summary {
  background: rgba(255,255,255,.08);
}

.mobile-nav nav {
  position: absolute;
  top: 72px;
  left: 0;
  right: 0;
  display: grid;
  gap: 2px;
  padding: 10px 14px 18px;
  background: #0c0c10;
  border-bottom: 1px solid var(--border);
}

.mobile-nav nav a:not(.meetup, .highlight) {
  padding: 13px 6px;
  font-size: 1.05rem;
  color: #e4e4e7;
  border-bottom: 1px solid rgba(255,255,255,.06);
}

.mobile-nav .meetup {
  margin-top: 14px;
  padding: 13px 16px;
  text-align: center;
}

.mobile-nav .highlight {
  margin: 4px 0 8px;
  padding: 12px 16px;
  font-size: 1.05rem;
}

/* Small screens: the links move behind the Menu button */
@media (max-width: 760px) {
  .desktop-nav a:not(.highlight) {
    display: none;
  }

  .mobile-nav {
    display: block;
  }

  .brand-logo {
    width: 42px;
  }
}

/* The event button takes room in the bar, so the Menu button takes over sooner while it is shown */
@media (max-width: 1000px) {
  .has-highlight .desktop-nav a:not(.highlight) {
    display: none;
  }

  .has-highlight .mobile-nav {
    display: block;
  }
}

/* Tablets show the event button in the bar, phones show it at the top of the menu */
@media (min-width: 521px) {
  .mobile-nav .highlight {
    display: none;
  }
}

@media (max-width: 520px) {
  .desktop-nav .highlight {
    display: none;
  }
}
</style>
