---
import { Image } from "astro:assets";
import placeholderArt from "../assets/volunteer-placeholder.jpg";

// One tile in the Community Day "Volunteer Team" grid, with the name underneath.
//
// A volunteer's photo is a finished square tile, made with tools/volunteer-tiles:
// the person cut out, in black and white, in front of the Kuala Lumpur skyline.
// It is shown as it is. A volunteer whose photo has not arrived yet, and an
// empty tile (placeholder), show the skyline with the silhouette instead.
//
// placeholder: an empty tile for a volunteer who has not been named yet.
// extra: a placeholder left out on phones, so the two-column grid ends on a full row
// and the page does not fill with empty tiles.
const { name = "", photo, linkedin, placeholder = false, extra = false } = Astro.props;

const files = import.meta.glob("/src/assets/volunteers/*.{jpg,jpeg,png,webp}", { eager: true });
const match = photo
  ? Object.entries(files).find(
      ([path]) => path.split("/").pop().replace(/\.[^.]+$/, "") === photo
    )
  : null;
const image = match ? match[1].default : placeholderArt;

// Never ask for a size larger than the image itself.
const maxWidth = Math.min(560, image.width);
const widths = [...new Set([280, maxWidth].filter((w) => w <= maxWidth))];
---

<article class:list={["volunteer", { empty: placeholder, extra }]} aria-hidden={placeholder ? "true" : undefined}>
  <div class="tile">
    <Image
      class="art"
      src={image}
      alt=""
      width={maxWidth}
      widths={widths}
      sizes="(max-width: 760px) 50vw, 220px"
    />
  </div>

  {placeholder ? (
    <p class="name">Volunteer to be announced</p>
  ) : linkedin ? (
    <h3 class="name">
      <a href={linkedin} target="_blank" rel="noopener noreferrer">
        {name}<span class="sr-only"> on LinkedIn</span>
      </a>
    </h3>
  ) : (
    <h3 class="name">{name}</h3>
  )}
</article>

<style>
.volunteer {
  margin: 0;
  min-width: 0;
}

.tile {
  position: relative;
  aspect-ratio: 7 / 6;
  overflow: hidden;
  border-radius: 4px;
  background: #0b0b2e;
}

.art {
  position: absolute;
  inset: 0;
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center 40%;
}

.name {
  margin: 12px 0 0;
  font-size: 1.05rem;
  font-weight: 700;
  line-height: 1.3;
  text-align: center;
  color: #fff;
  overflow-wrap: anywhere;
}

.name a {
  color: inherit;
  text-decoration: none;
}

.name a:hover {
  text-decoration: underline;
  text-underline-offset: .18em;
}

.empty .name {
  color: var(--muted);
  font-weight: 600;
  font-size: .95rem;
}

@media (max-width: 760px) {
  .name {
    font-size: .95rem;
  }

  .empty .name {
    font-size: .85rem;
  }

  .extra {
    display: none;
  }
}
</style>
