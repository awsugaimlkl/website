---
import { Image } from "astro:assets";

// One tile in the Community Day "Volunteer Team" grid: a purple V behind a
// black-and-white photo, with the name underneath.
// placeholder: an empty tile for a volunteer who has not been named yet.
//
// Photos live in src/assets/volunteers. A PNG or WebP with the background
// removed sits in front of the V, like a cut-out. A JPG fills the whole tile.
// extra: a placeholder left out on phones, so the two-column grid ends on a full row
// and the page does not fill with empty tiles.
const { name = "", photo, linkedin, placeholder = false, extra = false } = Astro.props;

const files = import.meta.glob("/src/assets/volunteers/*.{jpg,jpeg,png,webp}", { eager: true });
const match = photo
  ? Object.entries(files).find(
      ([path]) => path.split("/").pop().replace(/\.[^.]+$/, "") === photo
    )
  : null;
const image = match ? match[1].default : null;
const cutout = match ? /\.(png|webp)$/i.test(match[0]) : false;

const initials = name
  .split(/\s+/)
  .filter(Boolean)
  .slice(0, 2)
  .map((word) => word[0].toUpperCase())
  .join("");

// Never ask for a size larger than the photo itself.
const maxWidth = image ? Math.min(560, image.width) : 0;
const widths = [...new Set([280, maxWidth].filter((w) => w <= maxWidth))];
---

<article class:list={["volunteer", { empty: placeholder, extra }]} aria-hidden={placeholder ? "true" : undefined}>
  <div class="tile">
    <svg class="v" viewBox="0 0 100 86" preserveAspectRatio="none" aria-hidden="true">
      <polygon points="9,0 30,0 50,58 70,0 91,0 61,86 39,86" />
    </svg>

    {placeholder ? (
      <svg class="figure" viewBox="0 0 100 86" preserveAspectRatio="xMidYMax meet" aria-hidden="true">
        <ellipse cx="50" cy="37" rx="13" ry="15" />
        <path d="M44 47h12v12H44z" />
        <path d="M12 86c0-18 14-30 38-30s38 12 38 30z" />
      </svg>
    ) : image ? (
      <Image
        class:list={["photo", cutout ? "cutout" : "fill"]}
        src={image}
        alt=""
        width={maxWidth}
        widths={widths}
        sizes="(max-width: 760px) 50vw, 220px"
      />
    ) : (
      <span class="initials" aria-hidden="true">{initials}</span>
    )}
  </div>

  {placeholder ? (
    <p class="name">Volunteer to be announced</p>
  ) : linkedin ? (
    <h3 class="name">
      <a href={linkedin} target="_blank" rel="noopener noreferrer">
        {name}<span class="sr-only"> on LinkedIn</span>
      </a>
    </h3>
  ) : (
    <h3 class="name">{name}</h3>
  )}
</article>

<style>
.volunteer {
  margin: 0;
  min-width: 0;
}

/* Dark at the top, deep purple at the bottom, with the V on top of that */
.tile {
  position: relative;
  aspect-ratio: 7 / 6;
  overflow: hidden;
  border-radius: 4px;
  background: linear-gradient(180deg, #0b0b16 0%, #0b0b16 42%, #2a1063 100%);
}

.v {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.v polygon {
  fill: #7c5cbf;
}

/* A cut-out photo stands in front of the V, feet on the bottom edge */
.photo {
  position: absolute;
  display: block;
  filter: grayscale(1) contrast(1.05);
}

.cutout {
  left: 0;
  bottom: 0;
  width: 100%;
  height: 88%;
  object-fit: cover;
  object-position: center top;
}

/* A photo with its own background fills the tile */
.fill {
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center 30%;
}

.initials {
  position: absolute;
  left: 50%;
  bottom: 14%;
  transform: translateX(-50%);
  display: grid;
  place-items: center;
  width: 42%;
  aspect-ratio: 1;
  border-radius: 999px;
  background: #18181f;
  border: 2px solid #3f3f46;
  color: #e4e4e7;
  font-size: clamp(1.2rem, 2.4vw, 1.8rem);
  font-weight: 800;
  letter-spacing: -.03em;
}

/* An unnamed volunteer: a grey figure where the photo will go */
.figure {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  fill: #34343e;
}

.name {
  margin: 12px 0 0;
  font-size: 1.05rem;
  font-weight: 700;
  line-height: 1.3;
  text-align: center;
  color: #fff;
  overflow-wrap: anywhere;
}

.name a {
  color: inherit;
  text-decoration: none;
}

.name a:hover {
  text-decoration: underline;
  text-underline-offset: .18em;
}

.empty .name {
  color: var(--muted);
  font-weight: 600;
  font-size: .95rem;
}

@media (max-width: 760px) {
  .name {
    font-size: .95rem;
  }

  .empty .name {
    font-size: .85rem;
  }

  .extra {
    display: none;
  }
}
</style>
