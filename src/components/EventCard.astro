---
const {
  title,
  date,
  dateDisplay,
  venue,
  summary,
  href,
  past = false,
  featured = false,
  number,
  signups,
  talks = [],
} = Astro.props;

const label = past
  ? number ? `Meetup #${number}` : "Past event"
  : featured ? "Featured event" : "Upcoming event";
const pastLabel = number ? `Meetup #${number}` : "Past event";

// Only promise a recap when the page lists the talks.
const linkText = !past ? "View event" : talks.length > 0 ? "See what was covered" : "View meetup details";
---

<a class:list={["event-card", "card", { featured: featured && !past }]} href={href}>
  <span class="eyebrow" data-event-date={date} data-past-label={pastLabel}>{label}</span>
  <h3>{title}</h3>
  <div class="meta">{dateDisplay}</div>
  <div class="venue">{venue}</div>
  <p>{summary}</p>
  {signups && <p class="signups">{signups} signed up on Meetup</p>}
  <span class="more">{linkText}</span>
</a>

<style>
.event-card {
  padding: 26px;
  display: flex;
  flex-direction: column;
  transition: transform .2s ease, border-color .2s ease;
}

.event-card:hover {
  transform: translateY(-4px);
  border-color: #a855f7;
}

.event-card.featured {
  background:
    linear-gradient(145deg,rgba(255,153,0,.08),transparent 42%),
    linear-gradient(315deg,rgba(168,85,247,.12),transparent 45%),
    var(--surface);
}

h3 {
  font-size: 1.55rem;
  margin: 14px 0 18px;
}

.meta {
  color: #fff;
  font-weight: 750;
}

.venue {
  color: #c4b5fd;
  margin-top: 4px;
}

p {
  margin: 14px 0 0;
}

.signups {
  margin-top: 8px;
  color: #d4d4d8;
  font-weight: 600;
}

.more {
  margin-top: auto;
  padding-top: 18px;
  color: var(--orange);
  font-weight: 750;
  text-decoration: underline;
  text-decoration-color: rgba(255,153,0,.4);
  text-underline-offset: 4px;
}
</style>
