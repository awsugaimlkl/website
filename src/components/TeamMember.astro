---
import { Image } from "astro:assets";

const { name, role, linkedin, initials, photo } = Astro.props;

// Use the photo in src/assets/team if there is one, otherwise show initials.
const files = import.meta.glob("/src/assets/team/*.{jpg,jpeg,png,webp}", { eager: true });
const match = Object.entries(files).find(
  ([path]) => path.split("/").pop().replace(/\.[^.]+$/, "") === photo
);
const image = match ? match[1].default : null;
---

<article class="member card">
  {image ? (
    <Image
      class="portrait"
      src={image}
      alt={`Photo of ${name}`}
      width={Math.min(480, image.width)}
      widths={[160, 320, Math.min(480, image.width)]}
      sizes="140px"
    />
  ) : (
    <span class="portrait initials" aria-hidden="true">{initials}</span>
  )}
  <h3>{name}</h3>
  <p class="role">{role}</p>
  <a class="text-link" href={linkedin} target="_blank" rel="noopener noreferrer">
    LinkedIn<span class="sr-only"> profile of {name}</span>
  </a>
</article>

<style>
.member {
  padding: 28px;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.portrait {
  width: 140px;
  height: 140px;
  border-radius: 999px;
  border: 2px solid var(--purple);
  object-fit: cover;
  display: block;
  background: var(--surface-2);
}

.initials {
  display: grid;
  place-items: center;
  font-size: 2.6rem;
  font-weight: 800;
  letter-spacing: -.03em;
  color: #e9d5ff;
  background: linear-gradient(145deg, #3b0764, #18181f 75%);
}

h3 {
  font-size: 1.45rem;
  margin: 22px 0 6px;
}

.role {
  margin: 0 0 14px;
  color: #c4b5fd;
  font-weight: 600;
}
</style>
