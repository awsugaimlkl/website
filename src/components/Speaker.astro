---
import { Image } from "astro:assets";

const { name, role, talk, linkedin, photo } = Astro.props;

// Use the photo in src/assets/speakers if there is one, otherwise show initials.
const files = import.meta.glob("/src/assets/speakers/*.{jpg,jpeg,png,webp}", { eager: true });
const match = photo
  ? Object.entries(files).find(
      ([path]) => path.split("/").pop().replace(/\.[^.]+$/, "") === photo
    )
  : null;
const image = match ? match[1].default : null;

const initials = name
  .split(/\s+/)
  .filter(Boolean)
  .slice(0, 2)
  .map((word) => word[0].toUpperCase())
  .join("");

// Never ask for a size larger than the photo itself.
const maxWidth = image ? Math.min(360, image.width) : 0;
const widths = [...new Set([120, 240, maxWidth].filter((w) => w <= maxWidth))];
---

<article class="speaker">
  {image ? (
    <Image
      class="portrait"
      src={image}
      alt={`Photo of ${name}`}
      width={maxWidth}
      widths={widths}
      sizes="96px"
    />
  ) : (
    <span class="portrait initials" aria-hidden="true">{initials}</span>
  )}
  <div>
    <h3>{name}</h3>
    {role && <p class="role">{role}</p>}
    {talk && <p class="talk">{talk}</p>}
    {linkedin && (
      <a class="text-link" href={linkedin} target="_blank" rel="noopener noreferrer">
        LinkedIn<span class="sr-only"> profile of {name}</span>
      </a>
    )}
  </div>
</article>

<style>
.speaker {
  display: grid;
  grid-template-columns: 96px minmax(0, 1fr);
  gap: 18px;
  align-items: start;
  padding: 22px 0;
  border-top: 1px solid var(--border);
}

.portrait {
  width: 96px;
  height: 96px;
  border-radius: 999px;
  border: 2px solid var(--purple);
  object-fit: cover;
  display: block;
  background: var(--surface-2);
}

.initials {
  display: grid;
  place-items: center;
  font-size: 1.8rem;
  font-weight: 800;
  letter-spacing: -.03em;
  color: #e9d5ff;
  background: linear-gradient(145deg, #3b0764, #18181f 75%);
}

h3 {
  font-size: 1.25rem;
  line-height: 1.25;
  margin: 4px 0 4px;
}

.role {
  margin: 0;
  color: #c4b5fd;
  font-weight: 600;
  font-size: .95rem;
}

.talk {
  margin: 10px 0 0;
  color: #e4e4e7;
}

.text-link {
  display: inline-block;
  margin-top: 10px;
  font-size: .95rem;
}
</style>
