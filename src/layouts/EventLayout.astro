---
import BaseLayout from "./BaseLayout.astro";

const { frontmatter } = Astro.props;
const {
  title,
  description,
  dateDisplay,
  time,
  venue,
  registrationUrl,
  status = "upcoming"
} = frontmatter;
---

<BaseLayout title={`${title} | AWS UG AI/ML Kuala Lumpur`} description={description}>
  <main>
    <section class="event-hero">
      <div class="container">
        <span class="eyebrow">{status === "upcoming" ? "Upcoming Event" : "Past Event"}</span>
        <h1 class="gradient-text">{title}</h1>
        <p class="lead">{description}</p>

        <div class="details">
          <div>
            <small>Date</small>
            <strong>{dateDisplay}</strong>
          </div>
          <div>
            <small>Time</small>
            <strong>{time}</strong>
          </div>
          <div>
            <small>Venue</small>
            <strong>{venue}</strong>
          </div>
        </div>

        {registrationUrl && (
          <a class="btn btn-primary" href={registrationUrl} target="_blank">
            Register
          </a>
        )}
      </div>
    </section>

    <section class="section">
      <article class="container content card">
        <slot />
      </article>
    </section>
  </main>
</BaseLayout>

<style>
.event-hero {
  padding: 100px 0 55px;
}

.event-hero h1 {
  max-width: 960px;
  margin: 12px 0 22px;
}

.lead {
  max-width: 760px;
  font-size: 1.2rem;
}

.details {
  margin: 38px 0;
  display: grid;
  grid-template-columns: repeat(3,1fr);
  max-width: 900px;
  border: 1px solid var(--border);
  border-radius: 18px;
  overflow: hidden;
}

.details > div {
  padding: 20px;
  background: rgba(255,255,255,.025);
  border-right: 1px solid var(--border);
}

.details > div:last-child { border-right: 0; }

.details small,
.details strong {
  display: block;
}

.details small {
  color: var(--muted);
  margin-bottom: 5px;
}

.content {
  padding: 40px;
  max-width: 900px;
}

.content :global(h2) {
  margin-top: 40px;
  font-size: 1.8rem;
}

.content :global(li),
.content :global(p) {
  color: #c4c4cc;
}

@media(max-width:700px) {
  .details { grid-template-columns: 1fr; }
  .details > div { border-right:0; border-bottom:1px solid var(--border); }
}
</style>
