---
// Layout for a full-day event such as Community Day: a countdown, a menu of
// sections, speakers, schedule, sponsors, venue and the organizing team.
// Everything shown comes from the top of the event's .md file, so the page is
// updated there, not here. Sections with nothing to list yet show a short
// note on what happens next.

import { Image } from "astro:assets";
import BaseLayout from "./BaseLayout.astro";
import Speaker from "../components/Speaker.astro";
import TeamMember from "../components/TeamMember.astro";
import { isPast } from "../lib/dates.js";
import { getPhoto } from "../lib/photos.js";
import { SITE } from "../lib/site.js";
import { eventStructuredData } from "../lib/structured-data.js";
import { TEAM } from "../lib/team.js";

const { frontmatter } = Astro.props;
const {
  title,
  description,
  date,
  dateDisplay,
  time,
  startTime,
  endTime,
  venue,
  address,
  mapUrl,
  venueNote,
  gettingThere = [],
  registrationUrl,
  callForSpeakersUrl,
  calendarFile,
  highlights = [],
  topics = [],
  speakers = [],
  speakerSlots = 0,
  agenda = [],
  agendaNote,
  sponsors = [],
  photo,
  photoAlt = "",
  photoCaption,
} = frontmatter;

const past = isPast(date);
const pageUrl = new URL(Astro.url.pathname, Astro.site);
const eventData = eventStructuredData(frontmatter, pageUrl, Astro.site);

// Empty profiles shown until every speaker slot has a name in it.
const openSlots = past ? 0 : Math.max(0, speakerSlots - speakers.length);

// The moment the countdown runs to, and the moment the event ends, in Malaysia time.
const startsAt = startTime ? `${date}T${startTime}:00+08:00` : null;
const endsAt = endTime ? `${date}T${endTime}:00+08:00` : null;

// Sponsor logos live in src/assets/sponsors. A sponsor without a logo file is shown by name.
const logoFiles = import.meta.glob("/src/assets/sponsors/*.{png,jpg,jpeg,webp,svg}", { eager: true });
const logos = Object.fromEntries(
  Object.entries(logoFiles).map(([path, mod]) => [
    path.split("/").pop().replace(/\.[^.]+$/, ""),
    mod.default,
  ])
);

// Sponsors are grouped by tier, in the order the tiers first appear in the file.
const tiers = [...new Set(sponsors.map((s) => s.tier ?? "Sponsors"))].map((tier) => ({
  tier,
  sponsors: sponsors.filter((s) => (s.tier ?? "Sponsors") === tier),
}));

const sections = [
  { id: "about", label: "About" },
  { id: "speakers", label: "Speakers" },
  { id: "schedule", label: "Schedule" },
  { id: "registration", label: "Registration" },
  { id: "sponsors", label: "Sponsors" },
  { id: "venue", label: "Venue" },
  { id: "team", label: "Team" },
];
---

<BaseLayout title={`${title} | ${SITE.shortName}`} description={description}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(eventData)} />

  <main id="main">
    <section class="hero">
      <div class="container">
        <span
          class="eyebrow"
          data-event-date={date}
          data-event-start={startsAt}
          data-event-end={endsAt}
          data-live-label="Today"
          data-past-label="Past event"
        >
          {past ? "Past event" : "Upcoming event"}
        </span>
        <h1 class="gradient-text">{title}</h1>
        <p class="lead">{description}</p>

        <div class="pass">
          <dl class="when">
            <div>
              <dt class="sr-only">Date</dt>
              <dd class="date">{dateDisplay}</dd>
            </div>
            <div>
              <dt class="sr-only">Time</dt>
              <dd>{time}</dd>
            </div>
            <div>
              <dt class="sr-only">Venue</dt>
              <dd>{venue}</dd>
            </div>
          </dl>

          {/*
            The numbers are added by public/scripts/site.js. Nothing is written here on purpose:
            a search engine or tool that reads the page without running scripts would otherwise
            see a row of zeros. While the event is on it reads "Happening now", then it is removed.
          */}
          {!past && startsAt && (
            <div class="countdown" data-countdown={startsAt} data-countdown-end={endsAt}>
              <p class="sr-only" data-countdown-summary></p>
            </div>
          )}
        </div>

        {!past && (
          <div class="actions">
            {registrationUrl && (
              <a class="btn btn-primary" href={registrationUrl} target="_blank" rel="noopener noreferrer">
                Register
              </a>
            )}
            {callForSpeakersUrl && (
              <a
                class:list={["btn", registrationUrl ? "btn-secondary" : "btn-primary"]}
                href={callForSpeakersUrl}
                target="_blank"
                rel="noopener noreferrer"
              >
                Apply to speak
              </a>
            )}
            {calendarFile && <a class="btn btn-secondary" href={calendarFile}>Add to calendar</a>}
            {!registrationUrl && (
              <a class="btn btn-secondary" href={SITE.meetup} target="_blank" rel="noopener noreferrer">
                Get updates on Meetup
              </a>
            )}
          </div>
        )}
      </div>
    </section>

    <nav class="page-nav" aria-label="On this page">
      <div class="container">
        {sections.map((section) => <a href={`#${section.id}`}>{section.label}</a>)}
      </div>
    </nav>

    <section class="block" id="about" aria-labelledby="about-heading">
      <div class="container">
        <h2 id="about-heading">About the day</h2>
        <div class="body">
          <div class="prose about-text"><slot /></div>

          {highlights.length > 0 && (
            <dl class="highlights">
              {highlights.map((item) => (
                <div>
                  <dt>{item.title}</dt>
                  <dd>{item.text}</dd>
                </div>
              ))}
            </dl>
          )}

          {photo && (
            <figure class="photo">
              <Image
                src={getPhoto(photo)}
                alt={photoAlt}
                width={1700}
                widths={[480, 900, 1300, 1700]}
                sizes="(max-width: 960px) calc(100vw - 28px), 860px"
              />
              {photoCaption && <figcaption>{photoCaption}</figcaption>}
            </figure>
          )}
        </div>
      </div>
    </section>

    <section class="block" id="speakers" aria-labelledby="speakers-heading">
      <div class="container">
        <h2 id="speakers-heading">Speakers</h2>
        <div class="body">
          {speakers.length === 0 && (
            <p class="note">Speakers will be announced here as their talks are confirmed.</p>
          )}

          {(speakers.length > 0 || openSlots > 0) && (
            <div class="speaker-grid">
              {speakers.map((speaker) => <Speaker {...speaker} />)}
              {Array.from({ length: openSlots }, () => <Speaker placeholder />)}
            </div>
          )}

          {speakers.length > 0 && openSlots > 0 && (
            <p class="note">More speakers will be announced as their talks are confirmed.</p>
          )}

          {callForSpeakersUrl && !past && (
            <div class="call">
              <h3>The call for speakers is open</h3>
              <p>
                Community Day talks come from people who build with AI and machine learning on AWS.
                Tell us what you have built, shipped or run, and what others can learn from it.
              </p>
              {topics.length > 0 && (
                <ul class="topics" aria-label="Topics we are looking for">
                  {topics.map((topic) => <li class="tag">{topic}</li>)}
                </ul>
              )}
              <div class="actions">
                <a class="btn btn-primary" href={callForSpeakersUrl} target="_blank" rel="noopener noreferrer">
                  Apply to speak
                </a>
              </div>
              <p class="small">The application is a Google Form and opens in a new tab.</p>
            </div>
          )}
        </div>
      </div>
    </section>

    <section class="block" id="schedule" aria-labelledby="schedule-heading">
      <div class="container">
        <h2 id="schedule-heading">Schedule</h2>
        <div class="body">
          <p class="fact">{dateDisplay}<br />{time}, Malaysia time</p>

          {agendaNote && <p class="note">{agendaNote}</p>}

          {agenda.length > 0 ? (
            <ol class="agenda">
              {agenda.map((item) => (
                <li class:list={{ open: item.placeholder }}>
                  <span class="slot">{item.time}</span>
                  <div>
                    <strong>{item.title}</strong>{" "}
                    {item.placeholder && <span class="tag">To be announced</span>}
                    {item.speaker && <span class="by">{item.speaker}</span>}
                  </div>
                </li>
              ))}
            </ol>
          ) : (
            <p class="note">The session-by-session agenda will be published here once speakers are confirmed.</p>
          )}

          {calendarFile && !past && (
            <div class="actions">
              <a class="btn btn-secondary" href={calendarFile}>Add to calendar</a>
            </div>
          )}
        </div>
      </div>
    </section>

    <section class="block" id="registration" aria-labelledby="registration-heading">
      <div class="container">
        <h2 id="registration-heading">Registration</h2>
        <div class="body">
          {past ? (
            <p class="note">This event has taken place.</p>
          ) : registrationUrl ? (
            <Fragment>
              <p class="fact">Registration is open.</p>
              <div class="actions">
                <a class="btn btn-primary" href={registrationUrl} target="_blank" rel="noopener noreferrer">
                  Register
                </a>
              </div>
            </Fragment>
          ) : (
            <Fragment>
              <p class="fact">Registration is not open yet.</p>
              <p class="note">
                We will announce it on Meetup, LinkedIn and Facebook, and update this page on the same day.
              </p>
              <div class="actions">
                <a class="btn btn-secondary" href={SITE.meetup} target="_blank" rel="noopener noreferrer">
                  Get updates on Meetup
                </a>
              </div>
            </Fragment>
          )}
        </div>
      </div>
    </section>

    <section class="block" id="sponsors" aria-labelledby="sponsors-heading">
      <div class="container">
        <h2 id="sponsors-heading">Sponsors and partners</h2>
        <div class="body">
          {tiers.map((group) => (
            <div class="tier">
              <h3>{group.tier}</h3>
              <ul class="logos">
                {group.sponsors.map((sponsor) => {
                  const logo = sponsor.logo ? logos[sponsor.logo] : null;
                  const mark = logo
                    ? <Image src={logo} alt={sponsor.name} height={96} />
                    : <span class="wordmark">{sponsor.name}</span>;
                  return (
                    <li class:list={{ plain: !logo }}>
                      {sponsor.url
                        ? <a href={sponsor.url} target="_blank" rel="noopener noreferrer">{mark}</a>
                        : mark}
                    </li>
                  );
                })}
              </ul>
            </div>
          ))}

          {!past && (
            <Fragment>
              <p class="note">
                {sponsors.length > 0
                  ? "There is still room for more sponsors and community partners."
                  : "We are looking for sponsors and community partners."}
                {" "}Support the day and meet the people building AI on AWS in Malaysia.
              </p>
              <div class="actions">
                <a class="btn btn-secondary" href={SITE.linkedin} target="_blank" rel="noopener noreferrer">
                  Message us on LinkedIn
                </a>
              </div>
            </Fragment>
          )}
        </div>
      </div>
    </section>

    <section class="block" id="venue" aria-labelledby="venue-heading">
      <div class="container">
        <h2 id="venue-heading">Venue</h2>
        <div class="body">
          <p class="fact">{venue}</p>
          {address && <p class="address">{address}</p>}
          {venueNote && <p class="note">{venueNote}</p>}

          {gettingThere.length > 0 && (
            <dl class="routes">
              {gettingThere.map((route) => (
                <div>
                  <dt>{route.how}</dt>
                  <dd>{route.text}</dd>
                </div>
              ))}
            </dl>
          )}

          {mapUrl && (
            <div class="actions">
              <a class="btn btn-secondary" href={mapUrl} target="_blank" rel="noopener noreferrer">
                Open in Google Maps
              </a>
            </div>
          )}
        </div>
      </div>
    </section>

    <section class="block" id="team" aria-labelledby="team-heading">
      <div class="container">
        <h2 id="team-heading">Organizing team</h2>
        <div class="body">
          <p class="note">Community Day is organized by the group's User Group Leaders.</p>

          <div class="team-grid">
            {TEAM.map((member) => <TeamMember {...member} />)}
          </div>

          {!past && (
            <p class="note">
              Volunteers help with registration, rooms and speakers on the day.{" "}
              <a class="text-link" href={SITE.linkedin} target="_blank" rel="noopener noreferrer">
                Message us on LinkedIn
              </a>{" "}
              if you would like to join them.
            </p>
          )}
        </div>
      </div>
    </section>

    <div class="container">
      <p class="back"><a class="text-link" href="/events/">All events</a></p>
    </div>
  </main>
</BaseLayout>

<style>
/* ---------- Hero ---------- */

.hero {
  padding: 100px 0 56px;
}

.hero h1 {
  max-width: 960px;
  margin: 12px 0 22px;
}

.lead {
  max-width: 760px;
  font-size: 1.2rem;
  margin: 0;
}

/* Date, time and venue on the left, the countdown on the right */
.pass {
  margin: 38px 0 28px;
  max-width: 960px;
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  border: 1px solid var(--border);
  border-radius: 18px;
  overflow: hidden;
  background: rgba(255,255,255,.025);
}

.when {
  margin: 0;
  padding: 22px 24px;
  display: grid;
  gap: 3px;
  align-content: center;
}

.when dd {
  margin: 0;
  color: #d4d4d8;
}

.when .date {
  color: #fff;
  font-weight: 750;
  font-size: 1.2rem;
}

/* The size is fixed so the page does not jump when the script adds the numbers */
.countdown {
  border-left: 1px solid var(--border);
  display: grid;
  min-width: 416px;
  min-height: 97px;
}

/* Stays invisible until the script has put real numbers in */
.countdown:not(.is-live) {
  visibility: hidden;
}

/* With scripts switched off there is nothing to count, so give the space back */
@media (scripting: none) {
  .countdown { display: none; }
}

/* The cells are created by the script, so these rules are written as :global to reach them */
.countdown :global(.cells) {
  display: grid;
  grid-template-columns: repeat(4, 104px);
}

.countdown :global(.cells > div) {
  padding: 20px 6px 18px;
  text-align: center;
  display: grid;
  align-content: center;
  gap: 8px;
}

.countdown :global(.cells > div + div) {
  border-left: 1px solid var(--border);
}

.countdown :global(.cells strong) {
  font-size: 2.7rem;
  font-weight: 800;
  line-height: 1;
  letter-spacing: -.04em;
  font-variant-numeric: tabular-nums;
}

.countdown :global(.cells .days) {
  color: var(--orange);
}

.countdown :global(.cells span) {
  color: var(--muted);
  font-size: .84rem;
}

/* Shown in place of the numbers while the event is on */
.countdown :global(.now) {
  margin: 0;
  align-self: center;
  justify-self: center;
  color: var(--orange);
  font-size: 1.5rem;
  font-weight: 800;
  letter-spacing: -.02em;
}

/* ---------- Menu of sections ---------- */

.page-nav {
  border-top: 1px solid var(--border);
  background: rgba(9,9,11,.94);
}

.page-nav .container {
  display: flex;
  gap: 30px;
  overflow-x: auto;
  scrollbar-width: none;
}

.page-nav .container::-webkit-scrollbar {
  display: none;
}

.page-nav a {
  padding: 15px 0;
  color: #d4d4d8;
  font-size: .93rem;
  font-weight: 600;
  white-space: nowrap;
}

.page-nav a:hover {
  color: #fff;
}

/* ---------- Sections: heading on the left, content on the right ---------- */

.block {
  padding: 68px 0;
  border-top: 1px solid var(--border);
}

.block > .container {
  display: grid;
  grid-template-columns: 250px minmax(0, 1fr);
  gap: 24px 70px;
  align-items: start;
}

.block h2 {
  margin: 0;
  font-size: clamp(1.7rem, 2.5vw, 2.15rem);
  letter-spacing: -.03em;
  line-height: 1.12;
}

.body > :first-child {
  margin-top: 0;
}

.body > :last-child {
  margin-bottom: 0;
}

.body p,
.body dd,
.about-text :global(p),
.about-text :global(li) {
  color: #c4c4cc;
}

.body .actions {
  margin-top: 24px;
}

/* A line that states a fact: the date, the venue, whether registration is open */
.body .fact {
  margin: 0 0 10px;
  color: #fff;
  font-size: 1.3rem;
  font-weight: 700;
  line-height: 1.35;
}

.body .note {
  max-width: 62ch;
  margin: 0;
}

.about-text {
  max-width: 68ch;
  font-size: 1.08rem;
}

.about-text :global(p:first-child) {
  margin-top: 0;
}

.highlights {
  margin: 36px 0 0;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 0 40px;
}

.highlights > div {
  padding: 20px 0;
  border-top: 1px solid var(--border);
}

.highlights dt {
  color: #fff;
  font-weight: 750;
  font-size: 1.1rem;
}

.highlights dd {
  margin: 6px 0 0;
}

.body .photo {
  margin-top: 36px;
}

/* ---------- Speakers ---------- */

.speaker-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 0 40px;
}

.note + .speaker-grid {
  margin-top: 22px;
}

.speaker-grid + .note {
  margin-top: 18px;
}

.call {
  margin-top: 30px;
  padding: 34px;
  border: 1px solid rgba(255,153,0,.4);
  border-radius: 22px;
  background:
    radial-gradient(circle at 92% 0%, rgba(255,153,0,.16), transparent 42%),
    radial-gradient(circle at 0% 100%, rgba(168,85,247,.16), transparent 46%),
    var(--surface);
}

.call h3 {
  margin: 0 0 12px;
  font-size: 1.6rem;
  letter-spacing: -.02em;
}

.call p {
  max-width: 60ch;
  margin: 0;
}

.topics {
  list-style: none;
  padding: 0;
  margin: 22px 0 0;
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}

.call .small {
  margin-top: 14px;
  color: var(--muted);
  font-size: .88rem;
}

/* ---------- Schedule ---------- */

.agenda {
  list-style: none;
  padding: 0;
  margin: 24px 0 0;
}

.agenda li {
  display: grid;
  grid-template-columns: 190px minmax(0, 1fr);
  align-items: baseline;
  gap: 20px;
  padding: 16px 0;
  border-top: 1px solid var(--border);
}

.agenda li:last-child {
  border-bottom: 1px solid var(--border);
}

.agenda .slot {
  color: var(--orange);
  font-weight: 700;
  font-variant-numeric: tabular-nums;
}

.agenda li > div {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 6px 14px;
}

.agenda strong {
  line-height: 1.35;
}

.agenda .by {
  flex-basis: 100%;
  color: #c4b5fd;
}

/* A slot that is still to be filled: quieter, so confirmed slots stand out */
.agenda .open .slot {
  color: #c4b5fd;
}

.agenda .open strong {
  color: #d4d4d8;
  font-weight: 600;
}

/* ---------- Sponsors ---------- */

.tier {
  margin-bottom: 30px;
}

.tier h3 {
  margin: 0 0 14px;
  font-size: 1rem;
  font-weight: 700;
  color: #c4b5fd;
}

.logos {
  list-style: none;
  padding: 0;
  margin: 0;
  display: flex;
  flex-wrap: wrap;
  gap: 14px;
}

/* Logos sit on white so dark and coloured marks both stay readable */
.logos li {
  min-width: 170px;
  min-height: 92px;
  padding: 18px 24px;
  display: grid;
  place-items: center;
  border-radius: 14px;
  background: #fff;
}

.logos li.plain {
  background: rgba(255,255,255,.04);
  border: 1px solid var(--border);
}

.logos :global(img) {
  display: block;
  width: auto;
  height: auto;
  max-width: 180px;
  max-height: 56px;
}

.wordmark {
  font-weight: 750;
  font-size: 1.1rem;
}

/* ---------- Venue ---------- */

.body .address {
  margin: 0 0 14px;
}

.routes {
  margin: 28px 0 0;
}

.routes > div {
  display: grid;
  grid-template-columns: 190px minmax(0, 1fr);
  gap: 20px;
  padding: 16px 0;
  border-top: 1px solid var(--border);
}

.routes > div:last-child {
  border-bottom: 1px solid var(--border);
}

.routes dt {
  color: #fff;
  font-weight: 700;
}

.routes dd {
  margin: 0;
}

/* ---------- Team ---------- */

.team-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 18px;
  margin: 22px 0 26px;
}

.back {
  margin: 0;
  padding: 34px 0 80px;
  border-top: 1px solid var(--border);
}

/* ---------- Wide screens: the section menu and headings stay in view ---------- */

@media (min-width: 961px) {
  .page-nav {
    position: sticky;
    top: 72px;
    z-index: 40;
    border-bottom: 1px solid var(--border);
    backdrop-filter: blur(18px);
  }

  .page-nav + .block {
    border-top: 0;
  }

  /* Leave room for the section menu when jumping to a section */
  .block {
    scroll-margin-top: 50px;
  }

  .block h2 {
    position: sticky;
    top: 158px;
  }
}

/* ---------- Narrow screens ---------- */

@media (max-width: 960px) {
  .block {
    padding: 52px 0;
  }

  .block > .container {
    grid-template-columns: 1fr;
  }

  .team-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

@media (max-width: 760px) {
  .hero { padding: 64px 0 44px; }

  .pass { grid-template-columns: 1fr; }

  .countdown {
    border-left: 0;
    border-top: 1px solid var(--border);
    min-width: 0;
    min-height: 86px;
  }

  .countdown :global(.cells) { grid-template-columns: repeat(4, minmax(0, 1fr)); }

  .countdown :global(.cells strong) { font-size: 2.1rem; }

  .countdown :global(.cells > div) { padding: 16px 4px 14px; }

  .highlights,
  .speaker-grid,
  .team-grid { grid-template-columns: 1fr; }

  .call { padding: 26px 22px; }

  .agenda li,
  .routes > div {
    grid-template-columns: 1fr;
    gap: 4px;
  }
}
</style>
