---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";

const {
  title = "AWS User Group AI/ML Kuala Lumpur",
  description = "Kuala Lumpur community for builders, practitioners and enthusiasts working with AI, machine learning and AWS."
} = Astro.props;
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width" />
  <meta name="description" content={description} />
  <meta name="theme-color" content="#09090b" />
  <title>{title}</title>
</head>
<body>
  <Header />
  <slot />
  <Footer />
</body>
</html>
